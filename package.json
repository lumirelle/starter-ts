    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "bumpp": "^12.3.0",
    "changelogithub": "^15.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-oxlint": "^1.87.0",
    "knip": "^6.41.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pkg-pr-new": "^0.0.91",
    "publint": "^0.3.25",

{
  "name": "pkg-placeholder",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "nub@0.6.0",
  "description": "_description_",
  "author": "Lumirelle <shabbyacc@outlook.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/lumirelle",
  "homepage": "https://github.com/lumirelle/pkg-placeholder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumirelle/pkg-placeholder.git"
  },
  "bugs": "https://github.com/lumirelle/pkg-placeholder/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.6.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">22",
    "bun": ">1"
  },
  "workspaces": {
    "packages": []
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@lumirelle/oxlint-config": "^0.13.0",
    "@lumirelle/tsconfig": "^0.1.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "bumpp": "^12.1.1",
    "changelogithub": "^15.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.76.0",
    "knip": "^6.29.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pkg-pr-new": "^0.0.82",
    "publint": "^0.3.22",
    "taze": "^19.16.0",
    "tsdown": "^0.22.14",
    "tsnapi": "^1.2.0",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.7.tsgo.7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}

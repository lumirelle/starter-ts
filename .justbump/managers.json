{
  "version": 4,
  "verify": "run `mise run check` and `mise run test`; confirm the CLI still starts and the build passes",
  "managers": [
    {
      "name": "mise",
      "kind": "toolchain",
      "detect": ["mise.toml", "mise.lock"],
      "note": "project-scoped: --local keeps this off the machine-global config",
      "commands": {
        "check": "mise outdated --local --json",
        "bump": {
          "default": "mise upgrade --local",
          "major": "mise upgrade --local --bump"
        }
      }
    },
    {
      "name": "nub",
      "kind": "package",
      "detect": ["nub.lock", "packageManager=nub"],
      "note": "taze declared in devDependencies, so the Node lane is available; -x nub stops taze resolving the packageManager field (nub@…) against the unrelated npm package `nub` — the real nub is owned by mise",
      "commands": {
        "check": "nub outdated --json",
        "bump": {
          "default": "nub exec taze -x nub -w --no-interactive --no-node-version --no-github-actions --concurrency 2 --request-timeout 30000",
          "patch": "nub exec taze patch -x nub -w --no-interactive --no-node-version --no-github-actions --concurrency 2 --request-timeout 30000",
          "minor": "nub exec taze minor -x nub -w --no-interactive --no-node-version --no-github-actions --concurrency 2 --request-timeout 30000",
          "major": "nub exec taze major -x nub -w --no-interactive --no-node-version --no-github-actions --concurrency 2 --request-timeout 30000"
        },
        "refresh": [
          "node --input-type=commonjs -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\"",
          "nub install",
          "nub dedupe"
        ]
      }
    }
  ]
}
